# Backend API base URL used by server components/middleware (not exposed to the browser)
BACKEND_API_URL=http://localhost:5000

# Same backend URL, exposed to client components that fetch directly (pricing, testimonials, etc.)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# A DIFFERENT service: the Partiva Platform's own backend (tenants, employees,
# roles) -- not partiva-admin-backend above. Only the "Join Us as a Workshop /
# Client" forms talk to it, POSTing to its public /join-requests endpoint so
# a submission shows up in the Platform Admin's "Join Requests" review queue.
# Production: the Platform API's public HTTPS origin (no /api/v1), set at BUILD
# time; that API's CORS_ORIGIN must include this website's public origin(s).
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:4000
