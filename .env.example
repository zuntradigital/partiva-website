# Backend API base URL used by server components/middleware (not exposed to the browser)
BACKEND_API_URL=http://localhost:5000

# Same backend URL, exposed to client components that fetch directly (pricing, testimonials, etc.)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# reCAPTCHA v2 site key for the "Are you a robot?" widget (Contact, Register
# forms). The value below is Google's official public test key (always
# passes, zero real protection) -- fine for local development, but MUST be
# replaced with a real site key from https://www.google.com/recaptcha/admin,
# paired with a matching RECAPTCHA_SECRET_KEY in the backend's own env,
# before this runs in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# PRODUCTION: set the real site key as a plain RUNTIME variable on the host
# (RECAPTCHA_SITE_KEY -- not NEXT_PUBLIC_, which is frozen into the bundle at
# build time and is how Google's test key ended up on the live site). It takes
# precedence over NEXT_PUBLIC_RECAPTCHA_SITE_KEY; restart the app after changing
# it, no rebuild needed. Register the key at https://www.google.com/recaptcha/admin
# as reCAPTCHA v2 "I'm not a robot" Checkbox for partiva.tech (and www.partiva.tech),
# and put the paired secret in the backend's RECAPTCHA_SECRET_KEY.
# RECAPTCHA_SITE_KEY=
